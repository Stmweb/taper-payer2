{
  "name": "AGNV Transaction Completion Email",
  "description": "Sends an email notification to the sender when their AGNV transaction is successfully completed.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "AgnvTransaction"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "agnv_transaction_completion_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyAGNVCompletion",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyAGNVCompletion"
  }
}