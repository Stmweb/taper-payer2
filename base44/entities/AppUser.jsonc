{
  "name": "AppUser",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "User email address (unique)"
    },
    "password_hash": {
      "type": "string",
      "description": "Hashed password"
    },
    "full_name": {
      "type": "string",
      "description": "User full name"
    },
    "phone": {
      "type": "string",
      "description": "User phone number"
    },
    "country": {
      "type": "string",
      "description": "User's country"
    },
    "state": {
      "type": "string",
      "description": "User's state/province"
    },
    "cybrid_customer_id": {
      "type": "string",
      "description": "Cybrid customer ID"
    },
    "wallet_address": {
      "type": "string",
      "description": "ThirdWeb in-app wallet address on BNB Smart Chain"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active"
    },
    "reset_otp": {
      "type": "string",
      "description": "OTP code for password reset"
    },
    "reset_otp_expires": {
      "type": "string",
      "description": "Expiry timestamp for the reset OTP"
    },
    "fcm_token": {
      "type": "string",
      "description": "Firebase Cloud Messaging token for push notifications"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or description for this user"
    }
  },
  "required": [
    "email",
    "password_hash",
    "full_name",
    "phone"
  ]
}